
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          Int           @id @default(autoincrement())
  name        String
  categoryId  Int
  category    Category      @relation(fields: [categoryId], references: [id])
  price       Int
  image       String
  label       String?
  description String
  isActive    Boolean       @default(true)
  sizes       ProductSize[]
  orderItems  OrderItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId])
  @@index([isActive])
}

model ProductSize {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, size])
}

model Order {
  id                Int         @id @default(autoincrement())
  orderId           String      @unique
  fullName          String
  email             String
  phone             String
  street            String
  city              String
  state             String
  pinCode           String
  subtotal          Int
  shippingFee       Int
  total             Int
  paymentMethod     String
  paymentStatus     String      @default("pending")
  orderStatus       String      @default("placed")
  estimatedDelivery DateTime?
  items             OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([phone])
  @@index([createdAt])
}

model OrderItem {
  id            Int      @id @default(autoincrement())
  orderId       Int
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     Int?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName   String
  productImage  String
  size          String
  unitPrice     Int
  quantity      Int
  lineTotal     Int
  createdAt     DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}
